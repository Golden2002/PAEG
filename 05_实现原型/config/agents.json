      "enabled": true
    },
    "evaluator": {
      "provider": "auto",
      "model": null,
      "temperature": null,
      "max_tokens": null,
      "thinking_level": "OFF",
      "enabled": true
    },
    "adapter": {
      "provider": "auto",
      "model": null,
