  "_usage_examples": {
    "为 presenter 换模型": "改 agents.presenter.model 为 'deepseek-v4-flash' 或改 provider 为 'openai' + model 'gpt-4o-mini'",
    "关闭某 subagent": "改 agents.evaluator.enabled 为 false（回退确定性规则）",
    "调温度": "改 agents.presenter.temperature 为 0.5（更严谨）或 0.9（更有创意）",
