# PAEG 环境变量配置模板（v0.43）
# 复制为 .env 并填写真实值（.env 不入 git）

# ⭐ 生产环境必须设置（否则用开发默认值，仅适合本地）
PAEG_SECRET_KEY=change-me-to-a-random-string

# LLM 提供商（auto / mock / deepseek / openai / anthropic）
PAEG_LLM_PROVIDER=deepseek
# 模型名（默认 auto 自动识别）
PAEG_LLM_MODEL=auto

# DeepSeek API Key（使用 deepseek provider 时必填）
DEEPSEEK_API_KEY=

# 服务器端口
PORT=5000
# MCP 网关端口
MCP_PORT=8765
# 监听地址（默认 0.0.0.0）
PAEG_HOST=0.0.0.0

# 可选：联网搜索（未设置则走免 key 的 Bing 兜底）
# TAVILY_API_KEY=
# SERPER_API_KEY=
