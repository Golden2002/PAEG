{
  "meta": {
    "title": "光合作用：能量与物质的守恒之舞",
    "subject": "光合作用",
    "target_duration_sec": 120,
    "education_level": "高中",
    "style": "3blue1brown",
    "core_intuition": "光合作用本质上是能量与物质的守恒转换：光能将二氧化碳和水转化为有机物和氧气，过程中能量以化学键形式储存。",
    "learning_objectives": [
      "理解光合作用的总反应方程式及物质守恒",
      "理解光反应与暗反应（卡尔文循环）的区分与联系",
      "理解能量转化（光能→化学能）的守恒性"
    ]
  },
  "narrative_arc": {
    "hook": "从一片叶子的呼吸开始，揭示它背后的能量与物质循环。",
    "build_up": "展示二氧化碳和水如何被光能分解，能量被捕获。",
    "climax": "化学键的断裂与形成，物质守恒的直观呈现。",
    "resolution": "氧气释放，葡萄糖形成，能量储存在化学键中。"
  },
  "visual_system": {
    "palette": {
      "background": "#1e1e2e",
      "light_energy": "#ffd700",
      "carbon_dioxide": "#ff6b6b",
      "water": "#4dabf7",
      "glucose": "#ffa94d",
      "oxygen": "#69db7c",
      "energy_storage": "#ffd43b"
    },
    "semantic_mapping": {
      "light_energy": "光能输入",
      "carbon_dioxide": "二氧化碳分子",
      "water": "水分子",
      "glucose": "葡萄糖（有机物）",
      "oxygen": "氧气分子",
      "energy_storage": "储存的化学能"
    },
    "spatial_layout": "左侧为反应物，右侧为生成物，中间为反应过程；能量箭头自上而下贯穿。"
  },
