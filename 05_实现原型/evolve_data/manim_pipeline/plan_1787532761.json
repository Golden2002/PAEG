{
  "meta": {
    "title": "抛物线 y=x² 的直观之旅",
    "subject": "二次函数与抛物线",
    "audience": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "抛物线是到焦点和准线距离相等的点的轨迹，y=x² 是焦点在 (0,1/4) 的抛物线。",
    "learning_objectives": [
      "直观理解抛物线的定义：到焦点与准线距离相等",
      "认识 y=x² 的几何特征：对称轴、顶点、焦点与准线",
      "能将方程与几何对象对应起来"
    ]
  },
  "narrative_arc": {
    "hook": "从斜抛小球的曲线引出抛物线，提出‘这条曲线有什么秘密？’",
    "build": "通过几何探索发现抛物线上任意点到定点与定直线距离相等。",
    "climax": "揭示焦点 (0,1/4) 与准线 y=-1/4，并验证距离相等。",
    "resolution": "将几何定义与方程 y=x² 结合，总结对称性与关键点。"
  },
