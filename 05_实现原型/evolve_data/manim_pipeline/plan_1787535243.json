      "electron": "电子",
      "atp": "ATP",
      "nadph": "NADPH",
      "co2": "二氧化碳",
      "glucose": "葡萄糖"
    },
    "spatial_meaning": "左为光反应区，右为暗反应区，光强从左向右增强。"
  },
