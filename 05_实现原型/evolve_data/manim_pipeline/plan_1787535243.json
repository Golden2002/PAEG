{
  "meta": {
    "title": "光合作用的数学节律",
    "subject": "光合作用",
    "grade_level": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "光合作用像一台精密的机器，用光能驱动电子，将二氧化碳和水转化为有机物，速率与光强呈饱和曲线关系。",
    "learning_objectives": [
      "理解光合作用的总反应式",
      "理解光反应与暗反应的关系",
      "理解光照强度对光合速率的影响"
    ]
  },
  "narrative_arc": {
    "hook": "一束光射入绿叶，能量如何被捕获？",
    "build": "光能被叶绿素吸收，驱动电子传递，产生ATP和NADPH。",
    "climax": "暗反应利用ATP和NADPH固定CO2，生成葡萄糖。",
    "resolution": "光强增加，光合速率上升直至饱和，揭示速率曲线。"
  },
  "visual_system": {
    "palette": {
      "sunlight": "#FFD700",
