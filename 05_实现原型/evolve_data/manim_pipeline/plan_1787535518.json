{
  "meta": {
    "title": "光合作用：光能转化为化学能的数学直觉",
    "subject": "生物",
    "grade_level": "高中",
    "duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "光合作用本质上是能量形式的转换：光能（输入）转化为化学能（储存于葡萄糖），效率由能量转换率衡量。",
    "learning_objectives": [
      "理解光合作用的总反应式（CO2 + H2O → 葡萄糖 + O2）",
      "理解光反应与暗反应的能量流动",
      "掌握能量转换效率的计算方法"
    ]
  },
  "narrative_arc": {
    "hook": "太阳的能量如何进入食物链？",
    "build": "展示光能输入与化学能储存的对比",
    "climax": "揭示能量转换效率的数学关系",
    "resolution": "总结光合作用的核心意义"
  },
  "visual_system": {
    "palette": {
      "light_energy": "#FFD700",
      "chemical_energy": "#32CD32",
      "reactant": "#1E90FF",
      "product": "#FF6347",
      "background": "#0D1117",
      "text": "#E6E6E6"
    },
    "semantic_mapping": {
      "light_energy": "太阳光能（输入）",
      "chemical_energy": "化学能（葡萄糖中的能量）",
      "reactant": "反应物（CO2, H2O）",
      "product": "产物（葡萄糖, O2）",
      "background": "深色背景",
      "text": "文字颜色"
    }
  },
