          "t": 3,
          "type": "highlight",
          "target": "products",
          "mobject": "MathTex",
          "config": {
            "tex": "C_6H_{12}O_6 + 6O_2",
            "color": "product"
          }
        },
        {
          "t": 5,
          "type": "add_light",
          "target": "light_arrow",
          "mobject": "Arrow",
          "config": {
            "from": "above",
            "to": "equation",
            "color": "light_energy"
          }
        }
