{
  "meta": {
    "title": "导数与切线：从割线到极限",
    "subject": "导数与切线",
    "audience": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "切线是割线在两点无限接近时的极限位置",
    "learning_objectives": [
      "理解割线与切线的几何关系",
      "理解导数作为切线斜率的极限定义",
      "能够从几何直观过渡到导数符号表示"
    ]
  },
  "narrative_arc": {
    "hook": "一个静止的点和一条直线，如何找到穿过它的切线？",
    "build": "从割线出发，观察两点逐渐靠近时割线的变化",
    "climax": "两点重合的瞬间，割线成为切线，斜率成为极限",
    "resolution": "引入导数符号，将几何直观转化为数学表达"
  },
  "visual_system": {
    "palette": {
      "background": "#0b0e14",
      "curve": "#4fc3f7",
      "secant": "#ffb74d",
      "tangent": "#f44336",
      "points": "#ffffff",
      "text": "#e0e0e0",
      "axes": "#616161",
      "highlight": "#ffeb3b"
    },
    "semantic_binding": {
      "curve": "函数图像",
      "secant": "割线（两点连线）",
      "tangent": "切线（极限位置）",
      "points": "曲线上可移动的点",
      "axes": "坐标轴",
      "highlight": "关键点或关键变化"
    },
    "global_style": {
      "font": "CMU Serif",
      "stroke_width": 3,
      "point_radius": 0.08
    }
  },
  "scenes": [
    {
      "id": "s1_intro",
      "concept": "切线的直觉",
      "duration_sec": 15,
      "pause_after_sec": 2,
      "narration": "想象一条曲线，我们想要找到在某一点上的切线。直觉上，切线是刚好擦过该点的直线。",
      "prerequisites": [],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        }
      ],
      "animations": [
        {
          "t": 0,
          "type": "create",
          "target_ids": [
            "axes"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 1,
          "type": "create",
          "target_ids": [
            "curve"
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 3,
          "type": "create",
          "target_ids": [
            "point_p"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 5,
          "type": "indicate",
          "target_ids": [
            "point_p"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 7,
          "type": "write_text",
          "text": "切线是什么？",
          "position": [
            0,
            2.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        }
      ],
      "on_screen_text": "切线是什么？"
    },
    {
      "id": "s2_secant_approach",
      "concept": "割线的逼近",
      "duration_sec": 18,
      "pause_after_sec": 3,
      "narration": "我们引入另一个点Q，连接P和Q形成一条割线。当Q逐渐靠近P时，割线也在变化。",
      "prerequisites": [
        "s1_intro"
      ],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        },
        {
          "id": "point_q",
          "type": "dot",
          "position": [
            2.5,
            2.708,
            0
          ],
          "color": "points",
          "label": "Q"
        },
        {
          "id": "secant_line",
          "type": "line_between_points",
          "points": [
            "point_p",
            "point_q"
          ],
          "color": "secant"
