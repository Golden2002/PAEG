          "target_ids": [
            "point_q"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 1,
          "type": "create",
          "target_ids": [
            "secant_line"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 3,
          "type": "move_point",
          "target_id": "point_q",
          "path": "along_curve",
          "to": [
            2.0,
            0.667,
            0
          ],
          "duration": 3,
          "rate_func": "smooth"
        },
        {
          "t": 6,
          "type": "move_point",
          "target_id": "point_q",
          "path": "along_curve",
          "to": [
            1.8,
            0.144,
            0
          ],
          "duration": 3,
          "rate_func": "smooth"
        },
        {
          "t": 9,
          "type": "move_point",
          "target_id": "point_q",
          "path": "along_curve",
          "to": [
            1.6,
            -0.264,
            0
          ],
          "duration": 3,
          "rate_func": "smooth"
        }
      ],
      "on_screen_text": "割线逼近"
    },
    {
      "id": "s3_limit_formation",
      "concept": "极限的形成",
      "duration_sec": 20,
      "pause_after_sec": 4,
      "narration": "当Q无限接近P时，割线趋近于一个极限位置，这就是切线。这个极限就是导数的几何意义。",
      "prerequisites": [
        "s2_secant_approach"
      ],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        },
        {
          "id": "point_q",
          "type": "dot",
          "position": [
            1.55,
            -0.354,
            0
          ],
          "color": "points",
          "label": "Q"
        },
        {
          "id": "secant_line",
          "type": "line_between_points",
          "points": [
            "point_p",
            "point_q"
          ],
          "color": "secant"
        },
        {
          "id": "tangent_line",
          "type": "line_with_slope",
          "point": "point_p",
          "slope": 1.25,
          "color": "tangent"
        }
      ],
      "animations": [
        {
          "t": 0,
          "type": "move_point",
          "target_id": "point_q",
          "path": "along_curve",
          "to": [
            1.51,
            -0.371,
            0
          ],
          "duration": 4,
          "rate_func": "smooth"
        },
        {
          "t": 4,
          "type": "create",
          "target_ids": [
            "tangent_line"
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 6,
          "type": "fade_out",
          "target_ids": [
            "secant_line"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 7,
          "type": "flash",
          "target_ids": [
            "tangent_line"
          ],
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 8,
          "type": "write_text",
          "text": "极限位置",
          "position": [
            0,
            2.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        }
      ],
      "on_screen_text": "极限位置"
    },
    {
      "id": "s4_slope_visual",
      "concept": "斜率的几何意义",
      "duration_sec": 20,
      "pause_after_sec": 3,
      "narration": "切线的斜率告诉我们函数在该点的变化率。在图像上，斜率就是切线的倾斜程度。",
      "prerequisites": [
        "s3_limit_formation"
      ],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        },
        {
          "id": "tangent_line",
          "type": "line_with_slope",
          "point": "point_p",
          "slope": 1.25,
          "color": "tangent"
        },
        {
          "id": "slope_triangle",
          "type": "right_triangle",
          "point": "point_p",
          "dx": 1,
          "dy": 1.25,
          "color": "highlight"
        }
      ],
      "animations": [
        {
          "t": 0,
          "type": "create",
          "target_ids": [
            "slope_triangle"
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 2,
          "type": "write_text",
          "text": "斜率=1.25",
          "position": [
            0,
            2.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 5,
          "type": "highlight",
          "target_ids": [
            "slope_triangle"
          ],
          "duration": 2,
          "rate_func": "smooth"
        }
      ],
      "on_screen_text": "斜率=1.25"
    },
    {
      "id": "s5_derivative_symbol",
      "concept": "导数符号引入",
      "duration_sec": 25,
      "pause_after_sec": 4,
      "narration": "这个极限就是导数。我们记作f'(x)或者dy/dx。它表示函数在某一点的瞬时变化率。",
      "prerequisites": [
        "s4_slope_visual"
      ],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        },
        {
          "id": "tangent_line",
          "type": "line_with_slope",
          "point": "point_p",
          "slope": 1.25,
          "color": "tangent"
        }
      ],
      "animations": [
        {
          "t": 0,
          "type": "write_text",
          "text": "f'(x)",
          "position": [
            0,
            2.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 3,
          "type": "write_text",
          "text": "dy/dx",
          "position": [
            0,
            1.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 6,
          "type": "transform",
          "from": "slope_triangle",
          "to": "derivative_symbol",
          "duration": 3,
          "rate_func": "smooth"
        }
      ],
      "on_screen_text": "f'(x)"
    },
    {
      "id": "s6_summary",
      "concept": "总结与回顾",
      "duration_sec": 22,
      "pause_after_sec": 4,
      "narration": "总结：切线是割线的极限，导数就是切线的斜率。这就是微积分的核心思想之一。",
      "prerequisites": [
        "s5_derivative_symbol"
      ],
      "objects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴"
        },
        {
          "id": "curve",
          "type": "function_graph",
          "function": "x^3/3 - x",
          "color": "curve"
        },
        {
          "id": "point_p",
          "type": "dot",
          "position": [
            1.5,
            -0.375,
            0
          ],
          "color": "points",
          "label": "P"
        },
        {
          "id": "tangent_line",
