        }
      ],
      "animations": [
        {
          "t": 0,
          "type": "write_text",
          "text": "切线=极限",
          "position": [
            0,
            2.5,
            0
          ],
          "duration": 2,
          "rate_func": "smooth"
        },
        {
          "t": 3,
          "type": "write_text",
          "text": "导数=斜率",
          "position": [
            0,
            1.5,
            0
          ],
          "duration": 2,
