          ],
          "position": "on_curve_left",
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 5,
          "action": "show_dot",
          "targets": [
            "point_q"
          ],
          "position": "on_curve_right",
          "duration": 1,
          "rate_func": "smooth"
        },
        {
          "t": 7,
