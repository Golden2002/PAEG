{
  "meta": {
    "title": "导数的直觉：切线的斜率",
    "subject": "数学",
    "topic": "导数",
    "audience": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "导数就是曲线在某一点的切线斜率，它描述了函数在该点的瞬时变化率。",
    "learning_objectives": [
      "理解导数的几何意义：切线斜率",
      "理解瞬时变化率与平均变化率的关系",
      "初步认识极限思想"
    ]
  },
  "narrative_arc": {
    "hook": "从汽车速度表引入'瞬时'概念，引出如何测量瞬间的变化。",
    "build": "通过割线逼近切线，直观展示极限过程。",
    "climax": "明确切线斜率即导数，给出符号表示。",
    "resolution": "总结导数定义，强调其几何意义。"
  },
