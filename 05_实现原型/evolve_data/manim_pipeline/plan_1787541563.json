        "scene1"
      ],
      "mobjects": [
        {
          "id": "axes",
          "type": "axes",
          "description": "坐标轴，x轴和y轴"
        },
        {
          "id": "curve",
          "type": "curve",
          "description": "一条平滑上升曲线，函数图像"
        },
        {
          "id": "point_p",
          "type": "dot",
          "description": "曲线上一点P，白色"
        },
        {
          "id": "point_q",
          "type": "dot",
          "description": "曲线上另一点Q，白色"
        },
        {
          "id": "secant_line",
          "type": "line",
          "description": "连接P和Q的割线，橙色"
        }
      ],
      "animations": [
