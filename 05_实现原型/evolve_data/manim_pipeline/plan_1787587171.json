    {
      "id": "coordinate_expression",
      "concept": "坐标表达式",
      "duration_sec": 25,
      "prerequisites": [
        "basis_definition"
      ],
      "narration": "在新基下，向量 v 可以写成 b1 和 b2 的线性组合。系数就是新坐标。",
      "on_screen_text": "v = c1·b1 + c2·b2",
      "pause_after_sec": 3,
      "mobjects": [
        {
          "id": "vector_v",
          "type": "arrow",
          "description": "目标向量 v",
          "color": "vector"
