{
  "meta": {
    "title": "基变换与坐标系变换",
    "subject": "线性代数",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "audience": "高中",
    "core_intuition": "同一个向量，在不同坐标系下有不同的坐标；基变换就是切换观察视角。",
    "learning_objectives": [
      "理解基的概念：基是一组张成空间的向量",
      "理解同一向量在不同基下的坐标表示不同",
      "初步理解基变换矩阵的作用：从旧坐标到新坐标的转换"
    ]
  },
  "narrative_arc": {
    "hook": "同一个箭头，站在不同的人眼里，坐标竟然不同——这怎么可能？",
    "setup": "用两个不同的坐标系（标准基和另一组基）观察同一个向量，发现坐标不同。",
    "exploration": "通过动画演示从标准基到新基的变换过程，引入基变换矩阵。",
    "recap": "回顾核心：向量不变，坐标随基变；基变换矩阵是坐标的转换器。"
  },
  "visual_system": {
    "palette": {
      "background": "#0d1117",
      "standard_basis": "#58a6ff",
      "new_basis": "#f78166",
      "vector": "#ffd166",
      "grid": "#2d333b",
      "text": "#e6edf3",
      "highlight": "#7ee787"
    },
    "semantics": {
      "standard_basis": "标准基向量 e1, e2",
      "new_basis": "新基向量 b1, b2",
      "vector": "目标向量 v",
      "grid": "坐标系网格",
      "text": "文字和公式",
      "highlight": "强调或高亮"
    }
  },
