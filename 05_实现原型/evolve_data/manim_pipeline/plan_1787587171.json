      "id": "basis_definition",
      "concept": "基的定义",
      "duration_sec": 20,
      "prerequisites": [
        "two_views"
      ],
      "narration": "基就是一组向量，它们能张成整个平面，而且彼此独立。标准基是 (1,0) 和 (0,1)，新基是 (1,1) 和 (-1,1)。",
      "on_screen_text": "基 = 张成+独立",
      "pause_after_sec": 2,
      "mobjects": [
        {
          "id": "basis_e1",
          "type": "arrow",
          "description": "标准基向量 e1",
          "color": "standard_basis"
