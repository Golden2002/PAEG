    {
      "id": "change_of_basis_matrix",
      "concept": "基变换矩阵",
      "duration_sec": 25,
      "prerequisites": [
        "coordinate_expression"
      ],
      "narration": "把新基的坐标写成矩阵，乘以旧坐标，就能得到新坐标。这就是基变换矩阵。",
      "on_screen_text": "C = [b1 b2]",
      "pause_after_sec": 3,
      "mobjects": [
        {
          "id": "basis_b1",
          "type": "arrow",
          "description": "新基向量 b1",
