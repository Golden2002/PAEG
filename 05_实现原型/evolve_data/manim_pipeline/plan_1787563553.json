{
  "meta": {
    "title": "导数与切线",
    "subject": "数学",
    "education_level": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "导数就是切线的斜率，它告诉我们函数在某一点的变化快慢",
    "learning_objectives": [
      "理解割线逼近切线的极限过程",
      "理解导数的几何意义是切线的斜率",
      "能说出导数与切线的关系"
    ]
  },
  "narrative_arc": {
    "hook": "从一条曲线上的两个点开始，观察它们逐渐靠近时，连线（割线）如何变化",
    "build": "通过动画演示割线逼近切线的过程，建立直观认识",
    "climax": "在极限时刻，割线变成切线，斜率就是导数",
    "resolution": "用文字和符号总结核心概念，并引导学习者自我检测"
  },
  "visual_system": {
    "palette": {
      "curve": "#4ECDC4",
      "secant": "#FF6B6B",
      "tangent": "#FFD93D",
      "point": "#FFFFFF",
      "axis": "#888888",
      "text": "#FFFFFF"
    },
    "semantic_map": {
      "curve": "函数图像",
      "secant": "割线（两点连线）",
      "tangent": "切线（极限位置）",
      "point": "关键点（切点/动点）",
      "axis": "坐标轴",
      "text": "文字标注"
    },
    "global_style": {
      "background": "#1e1e1e",
      "font": "sans-serif",
      "line_width": 4
    }
  },
  "scenes": [
    {
      "id": "scene1",
      "concept": "割线的定义",
      "duration_sec": 15,
      "pause_after_sec": 2,
      "narration": "看这条曲线，上面有两个点。连接它们的线叫做割线。",
      "on_screen_text": "割线",
      "prerequisites": [],
      "mobjects": [
        {
          "id": "curve",
          "type": "function_graph",
          "definition": "f(x) = x^2",
          "color": "curve",
          "position": "center",
          "scale": 1.0
        },
        {
          "id": "point_A",
          "type": "dot",
          "position": "on_curve_at_x=-1",
          "color": "point"
        },
        {
          "id": "point_B",
          "type": "dot",
          "position": "on_curve_at_x=2",
          "color": "point"
        },
        {
          "id": "secant_AB",
          "type": "line",
          "from": "point_A",
          "to": "point_B",
          "color": "secant"
