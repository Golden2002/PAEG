      "fixed_point": "#FF6B6B",
      "coordinate_axes": "#FFFFFF",
      "text": "#FFFFFF",
      "highlight": "#FF6B6B"
    },
    "semantic_mapping": {
      "function_curve": "函数图像",
      "secant_line": "割线",
      "tangent_line": "切线",
      "moving_point": "动点",
      "fixed_point": "定点",
