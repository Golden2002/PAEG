{
  "meta": {
    "topic": "导数与切线",
    "audience": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "导数就是切线的斜率，切线是割线的极限",
    "learning_objectives": [
      "理解割线斜率的几何意义",
      "理解当两点靠近时割线趋近于切线",
      "理解导数定义为切线斜率的极限"
    ]
  },
  "narrative_arc": {
    "act1": "直觉建立：从割线到切线的视觉逼近",
    "act2": "符号引入：用符号表示斜率与极限",
    "act3": "综合理解：导数即切线斜率"
  },
  "visual_system": {
    "palette": {
      "function_curve": "#58C4DD",
      "secant_line": "#FFD166",
      "tangent_line": "#EF476F",
      "point_A": "#06D6A0",
      "point_B": "#118AB2",
      "text": "#FFFFFF",
      "background": "#0D1117"
    },
    "color_semantics": {
      "function_curve": "函数曲线",
      "secant_line": "割线",
      "tangent_line": "切线",
      "point_A": "固定点A",
      "point_B": "移动点B",
      "text": "文字",
      "background": "背景"
    },
    "global_objects": {
      "coordinate_axes": {
        "id": "axes_main",
        "type": "axes",
        "color": "#FFFFFF",
        "opacity": 0.6
      },
      "function_curve_obj": {
        "id": "curve_f",
        "type": "function_graph",
        "color": "#58C4DD",
        "function": "x^2"
      },
      "point_A_obj": {
        "id": "point_A",
        "type": "dot",
        "color": "#06D6A0",
        "position": [
          1,
          1,
          0
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "s1_curve_and_point",
      "concept": "曲线与固定点",
      "prerequisites": [],
      "duration_sec": 12,
      "visual_goal": "展示坐标轴、函数曲线和固定点A，建立直观印象",
      "narration": "这是一条曲线，我们关注曲线上的一个点A。",
      "on_screen_text": "曲线 与 点A",
      "animations": [
        {
          "t": 0,
          "type": "create",
          "target_id": "axes_main",
          "description": "显示坐标轴",
          "duration_sec": 2,
          "rate_func": "smooth"
        },
        {
          "t": 2,
          "type": "create",
          "target_id": "curve_f",
          "description": "绘制函数曲线 y=x^2",
          "duration_sec": 3,
          "rate_func": "smooth"
        },
        {
          "t": 5,
          "type": "create",
          "target_id": "point_A",
          "description": "在曲线上的点A处放置绿色点",
          "duration_sec": 2,
          "rate_func": "smooth"
        }
      ]
    },
    {
      "id": "s2_secant_intro",
      "concept": "割线引入",
      "prerequisites": [
        "s1_curve_and_point"
      ],
      "duration_sec": 15,
      "visual_goal": "在曲线上添加点B并绘制割线AB，展示割线斜率的几何意义",
      "narration": "我们在曲线上再取一个点B，连接A和B，得到一条割线。它的斜率是函数在区间上的平均变化率。",
      "on_screen_text": "割线 AB：平均变化率",
      "animations": [
        {
          "t": 0,
          "type": "create",
          "target_id": "point_B",
          "description": "在曲线右侧放置点B",
          "duration_sec": 2,
          "rate_func": "smooth"
        },
        {
          "t": 2,
          "type": "create",
          "target_id": "secant_AB",
          "description": "绘制割线AB，黄色",
          "duration_sec": 2,
          "rate_func": "smooth"
        },
        {
          "t": 4,
          "type": "label",
          "target_id": "secant_AB",
          "description": "标注斜率公式 (f(b)-f(a))/(b-a)",
          "duration_sec": 2,
          "rate_func": "smooth"
        }
      ]
    },
    {
      "id": "s3_secant_limit",
      "concept": "割线逼近切线",
      "prerequisites": [
        "s2_secant_intro"
      ],
      "duration_sec": 20,
      "visual_goal": "动态展示点B沿曲线靠近点A，割线逐渐逼近切线",
      "narration": "现在让点B沿着曲线向A靠近，你会发现割线越来越接近一条确定的直线——切线。",
      "on_screen_text": "B → A：割线趋向切线",
      "animations": [
        {
          "t": 0,
          "type": "animate",
          "target_id": "point_B",
          "description": "点B沿曲线向A移动",
          "duration_sec": 10,
          "rate_func": "smooth"
        },
        {
          "t": 0,
          "type": "animate",
          "target_id": "secant_AB",
          "description": "割线随B移动而旋转，逐渐贴近切线",
          "duration_sec": 10,
          "rate_func": "smooth"
        },
        {
          "t": 10,
          "type": "replace",
          "target_id": "secant_AB",
          "description": "当B接近A时，割线替换为切线",
          "duration_sec": 3,
          "rate_func": "smooth"
        }
      ]
    },
    {
      "id": "s4_tangent_definition",
      "concept": "导数定义",
      "prerequisites": [
        "s3_secant_limit"
      ],
      "duration_sec": 18,
      "visual_goal": "展示切线及其斜率，并引入导数符号 f'(a)",
      "narration": "当B无限接近A时，割线的极限就是切线，其斜率记为 f'(a)，这就是导数。",
      "on_screen_text": "f'(a) = 切线斜率",
      "animations": [
        {
          "t": 0,
          "type": "highlight",
          "target_id": "tangent_line",
          "description": "高亮切线，并显示斜率值",
          "duration_sec": 3,
          "rate_func": "smooth"
        },
        {
          "t": 3,
          "type": "label",
          "target_id": "tangent_line",
          "description": "标注 f'(a) = 斜率",
          "duration_sec": 3,
          "rate_func": "smooth"
        }
      ]
    },
    {
      "id": "s5_summary",
      "concept": "总结",
      "prerequisites": [
        "s4_tangent_definition"
      ],
      "duration_sec": 10,
      "visual_goal": "综合展示曲线、切线、导数符号，强化核心概念",
      "narration": "总结：导数就是切线的斜率，切线是割线的极限。",
      "on_screen_text": "导数 = 切线斜率 = 割线的极限",
      "animations": [
        {
          "t": 0,
          "type": "show",
          "target_id": "curve_f",
          "description": "保留曲线",
          "duration_sec": 2,
          "rate_func": "smooth"
        },
        {
          "t": 0,
          "type": "show",
          "target_id": "tangent_line",
          "description": "保留切线",
          "duration_sec": 2,
          "rate_func": "smooth"
        },
        {
          "t": 2,
          "type": "label",
          "target_id": "tangent_line",
          "description": "显示总结文字",
          "duration_sec": 3,
          "rate_func": "smooth"
        }
      ]
    }
  ]
}