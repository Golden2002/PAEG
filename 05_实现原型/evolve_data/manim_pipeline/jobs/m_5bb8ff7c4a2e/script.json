{
  "meta": {
    "title": "导数与切线",
    "subject": "数学",
    "grade_level": "高中",
    "target_duration_sec": 120,
    "style": "3blue1brown",
    "core_intuition": "切线是割线在动点无限靠近时的极限位置，导数就是这条切线的斜率。",
    "learning_objectives": [
      "理解割线如何通过极限过程变为切线",
      "理解导数的几何意义是切线斜率",
      "能说出导数符号 f'(a) 与切线斜率的对应关系"
    ]
  },
  "narrative_arc": {
    "hook": "从一条固定曲线上的两个点开始，观察它们逐渐靠近时，连线（割线）如何变化。",
    "rising_action": "让两个点不断靠近，割线方向持续改变，最终在极限处稳定为一条特殊直线。",
    "climax": "揭示这条极限直线就是切线，并标注其斜率即为导数。",
    "resolution": "给出导数符号 f'(a) 的几何意义总结。"
  },
  "visual_system": {
    "background_color": "#0b0e14",
    "palette": {
      "curve": "#4dd0e1",
      "secant": "#ffb74d",
      "tangent": "#ef5350",
      "point_a": "#ffeb3b",
      "point_b": "#ab47bc",
      "text": "#ffffff",
      "axis": "#888888"
    },
    "semantic_binding": {
      "curve": "函数曲线本身",
      "secant": "割线（两点连线）",
      "tangent": "切线（极限直线）",
      "point_a": "固定点 A（切点）",
      "point_b": "动点 B（趋近 A）",
      "text": "所有文字",
      "axis": "坐标轴"
    }
  },
