# PAEG 环境变量示例（复制为 .env 后填写）
# DeepSeek LLM（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key

# 可选 fallback 模型（§3.55 多模型链：DeepSeek → 阿里 → Mock）
# 配置阿里 key 作为 DeepSeek 缺失时的备选；都缺失才落 Mock（离线演示）
# 阿里通义千问（QWEN_API_KEY 或 DASHSCOPE_API_KEY 二选一）
# QWEN_API_KEY=your_qwen_api_key
# DASHSCOPE_API_KEY=your_dashscope_api_key
# QWEN_MODEL=qwen-plus

# 魔搭创空间部署：在平台"环境变量"配置 DEEPSEEK_API_KEY（或任一 fallback key），
# Docker 镜像无需改——llm_api 启动时自动按序检测（§3.55）

# 可选：自定义模型
# PAEG_API_KEY=
# PAEG_API_BASE=https://api.deepseek.com/v1
# PAEG_MODEL=deepseek-v4-flash

# 生产环境安全
# PAEG_ENV=production
# PAEG_SECRET_KEY=your_secret_key_here
# PAEG_CORS_ORIGINS=https://your.domain.com

# 语音（容器内默认）
WHISPER_MODEL=small
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 深度思考（可选）
# PAEG_REASONING=on

# 端口
# PORT=5000
